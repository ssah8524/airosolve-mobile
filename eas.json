{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "TLS_ENABLED": "true"
      }
    },
    "dev-no-tls": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "TLS_ENABLED": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "TLS_ENABLED": "true"
      }
    },
    "production": {
      "distribution": "internal",
      "env": {
        "TLS_ENABLED": "true"
      }
    }
  }
}
